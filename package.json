{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm generate:works-preview && pnpm generate:experience-preview",
    "dev": "next dev --turbopack",
    "generate:works-preview": "node scripts/generateWorksPreviews.mjs",
    "generate:works-preview:refresh": "node scripts/generateWorksPreviews.mjs --refresh",
    "generate:experience-preview": "node --import tsx scripts/generateExperiencePreviews.ts",
    "generate:experience-preview:refresh": "node --import tsx scripts/generateExperiencePreviews.ts --refresh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@iconify-icons/logos": "^1.2.36",
    "@iconify-icons/simple-icons": "^1.2.74",
