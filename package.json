    "@types/node": "^20.19.28",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
